{
  "name": "jog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test:perf": "JOG_PERF=1 vitest run --no-file-parallelism",
    "reference:extraire": "node scripts/lancer-ts.mjs scripts/extraire-reference.ts",
    "verif:reel": "node scripts/lancer-ts.mjs scripts/verif-reel.ts",
    "verif:reel:snapshot": "node scripts/lancer-ts.mjs scripts/verif-reel.ts --snapshot",
    "oracle": "TZ=America/Los_Angeles node scripts/lancer-ts.mjs scripts/oracle.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/schibsted-grotesk": "5.3.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "happy-dom": "21.0.4",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
